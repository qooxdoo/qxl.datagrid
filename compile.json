{
  "$schema": "https://qooxdoo.org/schema/compile-1-0-0.json",
  "targets": [
    {
      "type": "source",
      "outputPath": "compiled/source",
      "babelOptions": {
        "targets": "Chrome >= 80, Firefox >= 80, edge >= 18"
      }
    },
    {
      "type": "build",
      "outputPath": "compiled/build",
      "babelOptions": {
        "targets": "Chrome >= 80, Firefox >= 80, edge >= 18"
      }
    }
  ],
  "defaultTarget": "source",
  "locales": ["en"],
  "environment": {
    "qx.icontheme": "Tango"
  },
  "eslintConfig": {
    "globals": {
      "setTimeout": "readonly",
      "clearTimeout": "readonly",
      "performance": "readonly",
      "URLSearchParams": "readonly",
      "KeyboardEvent": "readonly",
      "PointerEvent": "readonly"
    }
  },
  "applications": [
    {
      "class": "qxl.datagrid.demo.Application",
      "theme": "qxl.datagrid.demo.theme.tangible.Theme",
      "name": "qxl.datagrid",
      "bootPath": "source/boot"
    },
    {
      "class": "qxl.testtapper.Application",
      "name": "testtapper",
      "theme": "qxl.datagrid.demo.theme.tangible.Theme",
      "title": "qxl.datagrid Tests",
      "default": false,
      "deploy": false,
      "environment": {
        "qxl.testtapper.testNameSpace": "qxl.datagrid.test"
      },
      "include": ["qxl.datagrid.test.*"]
    }
  ]
}
